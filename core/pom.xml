<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.alibaba.fastjson2</groupId>
        <artifactId>fastjson2-parent</artifactId>
        <version>2.0.63</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>${project.parent.groupId}</groupId>
    <version>${project.parent.version}</version>
    <artifactId>fastjson2</artifactId>
    <name>${project.artifactId}</name>
    <description>Fastjson is a JSON processor (JSON parser + JSON generator) written in Java</description>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <!-- OSGi bundle 文件名遵循 <BSN>_<version>.jar 惯例 -->
        <finalName>com.alibaba.fastjson2_${project.version}</finalName>
        <plugins>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>com/alibaba/fastjson2/**/*.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <user.timezone>Asia/Shanghai</user.timezone>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>5.1.9</version>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>com.alibaba.fastjson2</Bundle-SymbolicName>
                        <Bundle-Name>fastjson2 (OSGi)</Bundle-Name>
                        <Bundle-Vendor>Alibaba</Bundle-Vendor>
                        <Bundle-Description>Pure tree-model JSON library trimmed from fastjson2</Bundle-Description>
                        <Export-Package>com.alibaba.fastjson2;version="${project.version}",com.alibaba.fastjson2.util;version="${project.version}"</Export-Package>
                        <Import-Package>!jdk.internal.misc,!com.alibaba.fastjson2,!com.alibaba.fastjson2.util,sun.misc;resolution:=optional,*</Import-Package>
                        <Private-Package>com.alibaba.fastjson2.*</Private-Package>
                        <_removeheaders>Bnd-LastModified,Tool</_removeheaders>
                    </instructions>
                </configuration>
                <executions>
                    <execution>
                        <id>bundle-manifest</id>
                        <phase>package</phase>
                        <goals>
                            <goal>bundle</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
